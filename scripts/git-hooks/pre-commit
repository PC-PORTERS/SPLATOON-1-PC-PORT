#!/usr/bin/env bash
# Git pre-commit hook: Auto-format staged C/C++ files using clang-format
set -e

# Find clang-format executable
CLANG_FORMAT=""
for cmd in clang-format clang-format-23 clang-format-22 clang-format-21 clang-format-20 clang-format-19 clang-format-18 clang-format-17 clang-format-16; do
    if command -v "$cmd" >/dev/null 2>&1; then
        CLANG_FORMAT="$cmd"
        break
    fi
done

if [ -z "$CLANG_FORMAT" ]; then
    echo "[pre-commit] Warning: clang-format not found in PATH. Skipping auto-formatting."
    echo "[pre-commit] (Install clang-format or use 'git commit --no-verify' to bypass)"
    exit 0
fi

ROOT="$(git rev-parse --show-toplevel)"

# Staged C/C++ source files (Added, Copied, Modified, Renamed)
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACMR | grep -E '\.(c|cpp|cc|cxx|h|hpp|inl)$' || true)

if [ -z "$STAGED_FILES" ]; then
    exit 0
fi

FORMATTED_COUNT=0
for FILE in $STAGED_FILES; do
    # Ignore third-party and build/generated directories
    if [[ "$FILE" =~ ^recompiler/port/third_party/ ]] || \
       [[ "$FILE" =~ ^recompiler/third_party/ ]] || \
       [[ "$FILE" =~ ^build/ ]] || \
       [[ "$FILE" =~ ^Game/ ]]; then
        continue
    fi

    TARGET="$ROOT/$FILE"
    if [ -f "$TARGET" ]; then
        "$CLANG_FORMAT" -i "$TARGET"
        git add "$FILE"
        FORMATTED_COUNT=$((FORMATTED_COUNT + 1))
    fi
done

if [ "$FORMATTED_COUNT" -gt 0 ]; then
    echo "[pre-commit] Formatted and restaged $FORMATTED_COUNT file(s) with $CLANG_FORMAT."
fi

exit 0
